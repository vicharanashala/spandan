# =============================================================================
# Spandan Backend — Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# Variables marked REQUIRED must be set. Everything else has a working default.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=7001
NODE_ENV=development
# Path the app is mounted under in production (e.g. /spandan). Empty for local.
BASE_PATH=

# --- URLs / CORS -------------------------------------------------------------
# Include the base path in FRONTEND_URL (e.g. http://localhost:5173/spandan).
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed origins — no trailing slashes, no paths.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:8080

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/spandan
# Connection pool sizing — tune for your Mongo server capacity.
MONGO_MAX_POOL_SIZE=200
MONGO_MIN_POOL_SIZE=10

# --- Redis (optional) --------------------------------------------------------
# Leave empty for single-instance / local dev. Set to enable:
#   - Socket.IO Redis adapter (io.to(room).emit reaches ALL instances)
#   - Cross-instance rate limiting
#   - Live broadcast coordination
# Format: redis://[:password@]host:port[/db]
REDIS_URL=

# --- Auth --------------------------------------------------------------------
# REQUIRED — generate a strong random string (e.g. `openssl rand -hex 32`).
# Never commit the real value.
JWT_SECRET=

# Login token lifetime. 30d keeps students signed in for a full academic period.
JWT_EXPIRY=30d
BCRYPT_COST=10
AUTH_CACHE_MAX=20000
AUTH_CACHE_TTL_MS=60000

# --- AI Providers (question generation) -------------------------------------
# At least one key is needed for question generation to work.
# Leave unused providers empty.

# MiniMax — https://www.minimaxi.com → API Keys
MINIMAX_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Max concurrent generation jobs the worker processes at once.
GENERATION_CONCURRENCY=2

# --- Email -------------------------------------------------------------------
# Used for password reset, welcome, and registration OTP emails.
#
# Option A — Gmail SMTP (simplest for self-hosting):
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Create an App Password (Security → App passwords → Mail):
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password as SMTP_PASSWORD (spaces are fine).
SMTP_EMAIL=
SMTP_PASSWORD=

# Option B — Resend (transactional email service, simpler DNS setup):
#   1. Sign up at https://resend.com
#   2. Create an API key under API Keys in the dashboard.
#   When RESEND_API_KEY is set it takes priority over SMTP.
RESEND_API_KEY=

# Per-IP hourly cap on the OTP send endpoint. 500 tolerates a shared campus NAT.
OTP_LIMIT_PER_HOUR=500

# --- Transcription service ---------------------------------------------------
# URL the backend proxies audio to for faster-whisper speech-to-text.
TRANSCRIPTION_SERVICE_URL=http://127.0.0.1:3003
TRANSCRIPTION_PORT=3002
TRANSCRIBE_TIMEOUT_MS=30000

# --- Live updates / leaderboard tuning --------------------------------------
LIVE_UPDATE_THROTTLE_MS=1500
LEADERBOARD_IDLE_MS=12000
LEADERBOARD_TOP_N=20

# --- Response write buffering (default OFF) ----------------------------------
# Set to "on" to batch student answers via insertMany under heavy burst load.
RESPONSE_BATCH=off
RESPONSE_FLUSH_MS=250
RESPONSE_FLUSH_MAX=500

# --- Hot-path read caches ----------------------------------------------------
MEMBER_CACHE_TTL_MS=60000
QUESTION_CACHE_TTL_MS=30000
ROOM_QUESTIONS_CACHE_TTL_MS=10000

# --- Poll response window ----------------------------------------------------
# Grace period (ms) after a poll is superseded before late answers are rejected.
POLL_RESPONSE_GRACE_MS=10000
# Safety-net TTL for the per-room live-state cache in Redis (seconds).
ROOM_LIVE_CACHE_TTL_SEC=7200

# --- Research export API -----------------------------------------------------
# REQUIRED in production. Protects GET /api/research/sessions.
# Set to a strong random string and share with the researcher out-of-band.
# Generate with: openssl rand -hex 32
RESEARCH_API_KEY=

# --- Random-guess detection tuning (optional) --------------------------------
# Uncomment and adjust for testing. Production defaults apply when unset.

# Print every evaluation to the server console.
# RANDOM_GUESS_DEBUG=false

# Speed threshold: answer must arrive in under (tta * FRACTION) seconds.
# RANDOM_GUESS_ULTRA_FAST_MIN_SEC=1
# RANDOM_GUESS_ULTRA_FAST_MAX_SEC=2.5
# RANDOM_GUESS_ULTRA_FAST_FRACTION=0.15

# Consecutive ultra-fast answers needed to fire each signal.
# RANDOM_GUESS_INSIGHT_STREAK=3
# RANDOM_GUESS_PENALTY_STREAK=4
