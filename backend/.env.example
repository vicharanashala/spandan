# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and email reset links)
# Include the base path if using one (e.g., http://localhost:5173/spandan OR https://your-domain.com/spandan)
FRONTEND_URL=http://localhost:5173/spandan

# CORS allowed origins (comma-separated, no paths)
# For local dev: http://localhost:5173,http://localhost:3001,http://localhost:8080
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:8080

# MongoDB
# Leave blank to use in-memory MongoDB (no installation needed)
# For persistent data, set a MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/spandan
MONGODB_URI=mongodb://localhost:27017/spandan

# JWT Secret (REQUIRED -- generate a strong random string for every environment)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI Provider API Keys for Question Generation (all optional)
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# SMTP Email Configuration (for password reset & welcome emails)
# Using Gmail SMTP: enable 2FA and use an App Password -- do NOT use your real password
SMTP_EMAIL=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Optional: Resend API Key (alternative to Gmail SMTP)
RESEND_API_KEY=
