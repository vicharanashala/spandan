# =============================================================================
# Spandan Frontend — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# All variables must be prefixed with VITE_ to be exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Base Path
# Controls the sub-path the app is served under.
#   Local dev  → leave empty (Vite dev server serves from /)
#   Production → set to the nginx sub-path, e.g. /spandan
# This single value drives API_URL, SOCKET_URL, and SOCKET_PATH in config.js.
# -----------------------------------------------------------------------------
VITE_BASE_PATH=

# -----------------------------------------------------------------------------
# Socket URL  (optional)
# Defaults to window.location.origin when not set, which is correct for both
# local dev (proxied by Vite) and production (same domain as the frontend).
# Only set this if your Socket.IO server is on a different host or port.
#   Example: VITE_SOCKET_URL=http://localhost:8080
#   Example: VITE_SOCKET_URL=https://api.your-domain.com
# Do NOT include the base path here — SOCKET_PATH handles that automatically.
# -----------------------------------------------------------------------------
# VITE_SOCKET_URL=
