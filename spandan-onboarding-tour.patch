diff --git a/frontend/src/components/OnboardingTour.jsx b/frontend/src/components/OnboardingTour.jsx
new file mode 100644
index 0000000..5b453ae
--- /dev/null
+++ b/frontend/src/components/OnboardingTour.jsx
@@ -0,0 +1,190 @@
+import React, { useState, useEffect, useCallback, useMemo } from 'react'
+
+// Generic first-login walkthrough: dims the screen, cuts a "spotlight" hole around a real UI
+// element, and shows a small card next to it explaining what it does. Steps are just data
+// (see StudentDashboard.jsx for a real usage example), so this component can be reused for any
+// future flow — it doesn't know anything about Spandan's domain.
+//
+// Each step: { target: '[data-tour="..."]' | null, title, description, placement? }
+//   - target null (or not found in the DOM) renders a centered welcome/closing card with no
+//     spotlight — used for the first and last steps, and as a graceful fallback if a target
+//     element isn't mounted (e.g. a sidebar item hidden on mobile, or an empty-state section).
+//   - placement: 'bottom' | 'top' | 'left' | 'right' (default: 'bottom')
+//
+// onFinish(reason) fires exactly once, with reason 'completed' or 'skipped', whether the user
+// clicks through every step, hits Skip, or closes with the corner ✕. The caller is responsible
+// for persisting that the tour was seen (see StudentDashboard.jsx).
+export default function OnboardingTour({ steps, onFinish }) {
+  const [stepIndex, setStepIndex] = useState(0)
+  const [rect, setRect] = useState(null)
+
+  const step = steps[stepIndex]
+  const isLast = stepIndex === steps.length - 1
+
+  const measure = useCallback(() => {
+    if (!step?.target) {
+      setRect(null)
+      return
+    }
+    const el = document.querySelector(step.target)
+    if (!el) {
+      // Target isn't on screen right now (different viewport, empty state, etc.) — don't get
+      // stuck spotlighting nothing. Skip forward past it automatically.
+      setStepIndex((i) => (i < steps.length - 1 ? i + 1 : i))
+      return
+    }
+    el.scrollIntoView({ block: 'center', behavior: 'smooth' })
+    // Let the smooth scroll settle before measuring position.
+    window.setTimeout(() => {
+      const r = el.getBoundingClientRect()
+      setRect({ top: r.top, left: r.left, width: r.width, height: r.height })
+    }, 260)
+  }, [step, steps.length])
+
+  useEffect(() => {
+    measure()
+    window.addEventListener('resize', measure)
+    window.addEventListener('scroll', measure, true)
+    return () => {
+      window.removeEventListener('resize', measure)
+      window.removeEventListener('scroll', measure, true)
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [stepIndex])
+
+  useEffect(() => {
+    const onKey = (e) => {
+      if (e.key === 'Escape') finish('skipped')
+      if (e.key === 'ArrowRight') next()
+      if (e.key === 'ArrowLeft') back()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [stepIndex])
+
+  const finish = (reason) => onFinish?.(reason)
+  const next = () => (isLast ? finish('completed') : setStepIndex((i) => i + 1))
+  const back = () => setStepIndex((i) => Math.max(0, i - 1))
+
+  const cardStyle = useMemo(() => {
+    const base = {
+      position: 'fixed',
+      zIndex: 1001,
+      width: 'min(320px, calc(100vw - 32px))',
+      background: 'var(--bg-card)',
+      color: 'var(--text-primary)',
+      borderRadius: 'var(--radius-lg)',
+      boxShadow: 'var(--shadow-lg)',
+      border: '1px solid var(--border-color)',
+      padding: '20px',
+      boxSizing: 'border-box'
+    }
+    if (!rect) {
+      return { ...base, top: '50%', left: '50%', transform: 'translate(-50%, -50%)' }
+    }
+    const placement = step.placement || 'bottom'
+    const gap = 16
+    const vw = window.innerWidth
+    const vh = window.innerHeight
+    const cardWidth = 320
+    const cardHeight = 200 // rough estimate for clamping; actual height can vary slightly
+
+    let top, left
+    if (placement === 'bottom') {
+      top = rect.top + rect.height + gap
+      left = rect.left + rect.width / 2 - cardWidth / 2
+    } else if (placement === 'top') {
+      top = rect.top - gap - cardHeight
+      left = rect.left + rect.width / 2 - cardWidth / 2
+    } else if (placement === 'left') {
+      top = rect.top + rect.height / 2 - cardHeight / 2
+      left = rect.left - gap - cardWidth
+    } else {
+      top = rect.top + rect.height / 2 - cardHeight / 2
+      left = rect.left + rect.width + gap
+    }
+    // Clamp on-screen with a small margin.
+    top = Math.max(12, Math.min(top, vh - 12))
+    left = Math.max(12, Math.min(left, vw - cardWidth - 12))
+
+    return { ...base, top: `${top}px`, left: `${left}px` }
+  }, [rect, step])
+
+  return (
+    <>
+      {/* Backdrop with a spotlight cutout around the target element. A giant box-shadow on a
+          transparent, rect-sized div fills the rest of the viewport with a dim overlay — the
+          simplest way to get a clean "hole" without SVG masks. Deliberately non-interactive
+          (pointer-events: none) so the page underneath stays usable — a student can follow along
+          and actually click the highlighted element while reading the card, rather than being
+          blocked by an inert dimmed layer. Dismissing only happens via the card's own buttons. */}
+      <div
+        style={{
+          position: 'fixed',
+          zIndex: 1000,
+          top: rect ? rect.top - 6 : '50%',
+          left: rect ? rect.left - 6 : '50%',
+          width: rect ? rect.width + 12 : 0,
+          height: rect ? rect.height + 12 : 0,
+          borderRadius: '12px',
+          boxShadow: '0 0 0 9999px rgba(15, 23, 42, 0.65)',
+          transition: 'top 0.25s ease, left 0.25s ease, width 0.25s ease, height 0.25s ease',
+          pointerEvents: 'none'
+        }}
+      />
+
+      <div style={cardStyle}>
+        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: '12px' }}>
+          <h3 style={{ margin: 0, fontSize: '16px', fontWeight: 700, letterSpacing: '-0.01em' }}>
+            {step.title}
+          </h3>
+          <button
+            onClick={() => finish('skipped')}
+            aria-label="Close tutorial"
+            style={{
+              background: 'transparent', border: 'none', cursor: 'pointer',
+              color: 'var(--text-secondary)', fontSize: '16px', lineHeight: 1, padding: '2px', flexShrink: 0
+            }}
+          >✕</button>
+        </div>
+
+        <p style={{ margin: '10px 0 18px', fontSize: '14px', lineHeight: 1.5, color: 'var(--text-secondary)' }}>
+          {step.description}
+        </p>
+
+        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '12px' }}>
+          <div style={{ display: 'flex', gap: '5px' }}>
+            {steps.map((_, i) => (
+              <span key={i} style={{
+                width: '6px', height: '6px', borderRadius: '50%',
+                background: i === stepIndex ? 'var(--accent-gradient)' : 'var(--border-color)'
+              }} />
+            ))}
+          </div>
+
+          <div style={{ display: 'flex', gap: '8px' }}>
+            {stepIndex > 0 && (
+              <button
+                onClick={back}
+                style={{
+                  padding: '8px 14px', fontSize: '13px', fontWeight: 600,
+                  background: 'transparent', color: 'var(--text-secondary)',
+                  border: '1px solid var(--border-color)', borderRadius: 'var(--radius-sm)', cursor: 'pointer'
+                }}
+              >Back</button>
+            )}
+            <button
+              onClick={next}
+              style={{
+                padding: '8px 16px', fontSize: '13px', fontWeight: 600,
+                background: 'var(--accent-gradient)', color: '#fff',
+                border: 'none', borderRadius: 'var(--radius-sm)', cursor: 'pointer'
+              }}
+            >{isLast ? 'Get started' : 'Next'}</button>
+          </div>
+        </div>
+      </div>
+    </>
+  )
+}
